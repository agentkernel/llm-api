# WorkBuddy 生产环境变量样例（复制为 .env 后填入真实值，chmod 600，绝不提交）
#
#   cp .env.example .env && chmod 600 .env
#
# 生成随机值：
#   openssl rand -hex 32        # JWT_SECRET / TOTP_ENCRYPTION_KEY / ENVELOPE_MASTER_KEY_HEX（64 hex）
#   openssl rand -base64 33     # 数据库密码 / WB_SERVICE_API_KEY / DEVICE_HMAC_SECRET（≥32 字符）

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 对外端口与地址 ----
# 网关与管理台端口（Sub2API 容器内固定 8080）
SUB2API_HOST_PORT=18080
COMPANION_HOST_PORT=8720
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# 桌面端与 WorkBuddy 实际访问的网关地址，必须以 /v1 结尾（写进 models.json）
GATEWAY_URL=http://<服务器地址>:18080/v1
# 有域名后填写，Caddy 即按域名分流；留空则按 IP 访问默认进 Sub2API
SUB2API_DOMAIN=
COMPANION_DOMAIN=

# ---- Sub2API 构建上下文（已应用 workbuddy-patch 的源码目录）----
SUB2API_BUILD_CONTEXT=/opt/wb/build/sub2api
SUB2API_IMAGE=wb-sub2api:v0.1.175-workbuddy
COMPANION_IMAGE=wb-companion:0.1.0

# ---- 数据库 ----
SUB2API_DB_USER=sub2api
SUB2API_DB_PASSWORD=
SUB2API_DB_NAME=sub2api
COMPANION_DB_USER=companion
COMPANION_DB_PASSWORD=
COMPANION_DB_NAME=companion

# ---- Redis ----
REDIS_PASSWORD=

# ---- Sub2API 管理员与密钥 ----
ADMIN_EMAIL=admin@wb.local
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
PAYMENT_RESUME_SIGNING_KEY=

# ---- 服务间与 companion 密钥 ----
# Sub2API 与 companion 必须一致；未配置时补丁的服务间支付路由不注册
WB_SERVICE_API_KEY=
# Sub2API 全局 Admin Key，由初始化脚本生成后回填
SUB2API_ADMIN_KEY=
# ≥32 字符；变更后所有设备无法凭机器码找回
DEVICE_HMAC_SECRET=
# 64 位 hex（32 字节）；信封加密主密钥，丢失即无法解密设备凭据
ENVELOPE_MASTER_KEY_HEX=
# 由 companion CLI escrow:init 输出后回填，购买功能必填
ESCROW_USER_ID=
HIDDEN_USER_EMAIL_DOMAIN=wb-device.internal
RATE_LIMIT_PER_MINUTE=60
