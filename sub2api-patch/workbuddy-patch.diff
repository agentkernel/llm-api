--- /dev/null
+++ b/backend/internal/server/routes/wb_service.go
@@ -0,0 +1,31 @@
+package routes
+
+// WorkBuddy patch: service-to-service routes for the companion service.
+// The whole group is skipped unless a service key is configured, so a stock
+// deployment is completely unaffected.
+
+import (
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+
+	"github.com/gin-gonic/gin"
+)
+
+// RegisterWBServiceRoutes registers /api/v1/service/payment endpoints.
+func RegisterWBServiceRoutes(v1 *gin.RouterGroup, wbHandler *handler.WBServicePaymentHandler, serviceKey string) {
+	if wbHandler == nil || strings.TrimSpace(serviceKey) == "" {
+		return
+	}
+	group := v1.Group("/service/payment")
+	group.Use(middleware.WBServiceAuth(serviceKey))
+	{
+		orders := group.Group("/orders")
+		{
+			orders.POST("", wbHandler.CreateOrder)
+			orders.GET("/:out_trade_no", wbHandler.GetOrder)
+			orders.POST("/:out_trade_no/fulfill", wbHandler.Fulfill)
+		}
+	}
+}
