+	panic("unexpected call")
+}
+
+func (r *wbDeferredRedeemRepo) Use(_ context.Context, id, userID int64) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, code := range r.codesByCode {
+		if code.ID != id {
+			continue
+		}
+		if code.Status != StatusUnused {
+			return ErrRedeemCodeUsed
+		}
+		now := time.Now().UTC()
+		code.Status = StatusUsed
+		code.UsedBy = &userID
+		code.UsedAt = &now
+		return nil
+	}
+	return ErrRedeemCodeNotFound
+}
