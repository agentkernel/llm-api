diff --git a/backend/internal/server/middleware/wb_service_auth.go b/backend/internal/server/middleware/wb_service_auth.go
new file mode 100644
index 0000000..a24abf7
--- /dev/null
+++ b/backend/internal/server/middleware/wb_service_auth.go
@@ -0,0 +1,27 @@
+package middleware
+
+// WorkBuddy patch: shared-secret auth for the companion service endpoints.
+// The key comes from the WB_SERVICE_API_KEY environment variable; when it is
+// empty the routes are not registered at all (see routes/wb_service.go), so
+// this middleware never sees an empty expected key in practice but still
+// rejects that case defensively.
+
+import (
+	"crypto/subtle"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// WBServiceAuth validates the x-service-key header against the configured key.
+func WBServiceAuth(serviceKey string) gin.HandlerFunc {
+	expected := []byte(strings.TrimSpace(serviceKey))
+	return func(c *gin.Context) {
+		provided := []byte(strings.TrimSpace(c.GetHeader("x-service-key")))
+		if len(expected) == 0 || subtle.ConstantTimeCompare(expected, provided) != 1 {
+			AbortWithError(c, 401, "INVALID_SERVICE_KEY", "Invalid service key")
+			return
+		}
+		c.Next()
+	}
+}
