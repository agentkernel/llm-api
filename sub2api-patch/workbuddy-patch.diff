+func TestWBDeferredHoldParksOrderWithoutCrediting(t *testing.T) {
+	f := newWBDeferredFixture(t, "wb_hold")
+	f.payAndHold(t)
+
+	reloaded := f.reloadOrder(t)
+	require.Equal(t, OrderStatusPaidPendingRedeem, reloaded.Status)
+	require.NotNil(t, reloaded.PaidAt)
+	require.Nil(t, reloaded.CompletedAt)
+
+	code, err := f.redeemRepo.GetByCode(context.Background(), f.order.RechargeCode)
+	require.NoError(t, err)
+	require.Equal(t, StatusUnused, code.Status)
+	require.Equal(t, f.order.Amount, code.Value)
+
+	require.Empty(t, f.userRepo.credits, "no balance may be credited while parked")
+}
