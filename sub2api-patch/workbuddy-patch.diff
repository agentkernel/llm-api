+func (r *wbDeferredUserRepo) GetByID(_ context.Context, id int64) (*User, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	u, ok := r.users[id]
+	if !ok {
+		return nil, fmt.Errorf("user %d not found", id)
+	}
+	cloned := *u
+	return &cloned, nil
+}
