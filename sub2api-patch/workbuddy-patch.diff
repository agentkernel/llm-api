+func (r *wbDeferredUserRepo) UpdateBalance(_ context.Context, id int64, amount float64) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.balances[id] += amount
+	r.credits = append(r.credits, id)
+	return nil
+}
