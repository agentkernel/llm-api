diff --git a/backend/internal/handler/wb_service_payment_handler.go b/backend/internal/handler/wb_service_payment_handler.go
new file mode 100644
index 0000000..06fe5bb
--- /dev/null
+++ b/backend/internal/handler/wb_service_payment_handler.go
@@ -0,0 +1,103 @@
+package handler
+
+// WorkBuddy patch: service-to-service payment endpoints used by the WorkBuddy
+// companion service. Registered under /api/v1/service/payment and guarded by
+// the x-service-key middleware (see middleware/wb_service_auth.go). The
+// desktop client never talks to these endpoints directly.
+
+import (
+	"strings"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+
+	"github.com/gin-gonic/gin"
+)
+
+// WBServicePaymentHandler exposes deferred-order operations to the companion.
+type WBServicePaymentHandler struct {
+	paymentService *service.PaymentService
+}
+
+// NewWBServicePaymentHandler reuses the payment service already wired into the
+// user-facing PaymentHandler, so no dependency-injection changes are needed.
+func NewWBServicePaymentHandler(base *PaymentHandler) *WBServicePaymentHandler {
+	if base == nil {
+		return nil
+	}
+	return &WBServicePaymentHandler{paymentService: base.paymentService}
+}
+
+type wbCreateOrderRequest struct {
+	UserID        int64   `json:"user_id" binding:"required"`
+	Amount        float64 `json:"amount" binding:"required"`
+	PaymentType   string  `json:"payment_type" binding:"required"`
+	DeviceBinding string  `json:"device_binding"`
+	ClientIP      string  `json:"client_ip"`
+}
+
+// CreateOrder creates a deferred balance order and returns the provider
+// payload (qr_code / pay_url) for the desktop client to render.
+// POST /api/v1/service/payment/orders
+func (h *WBServicePaymentHandler) CreateOrder(c *gin.Context) {
+	var req wbCreateOrderRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.BadRequest(c, "invalid request: "+err.Error())
+		return
+	}
+	clientIP := strings.TrimSpace(req.ClientIP)
+	if clientIP == "" {
+		clientIP = c.ClientIP()
+	}
+	resp, err := h.paymentService.WBCreateDeferredOrder(c.Request.Context(), service.WBCreateDeferredOrderRequest{
+		UserID:        req.UserID,
+		Amount:        req.Amount,
+		PaymentType:   req.PaymentType,
+		DeviceBinding: req.DeviceBinding,
+		ClientIP:      clientIP,
+		SrcHost:       c.Request.Host,
+	})
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, resp)
+}
+
+// GetOrder returns the minimal deferred-order state for polling.
+// GET /api/v1/service/payment/orders/:out_trade_no
+func (h *WBServicePaymentHandler) GetOrder(c *gin.Context) {
+	status, err := h.paymentService.WBGetDeferredOrder(c.Request.Context(), c.Param("out_trade_no"))
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, status)
+}
+
+type wbFulfillRequest struct {
+	UserID        int64  `json:"user_id" binding:"required"`
+	DeviceBinding string `json:"device_binding"`
+}
+
+// Fulfill redeems a parked order to the given user. Requires an
+// Idempotency-Key header; the operation itself is idempotent per user.
+// POST /api/v1/service/payment/orders/:out_trade_no/fulfill
+func (h *WBServicePaymentHandler) Fulfill(c *gin.Context) {
+	if strings.TrimSpace(c.GetHeader("Idempotency-Key")) == "" {
+		response.ErrorFrom(c, infraerrors.BadRequest("IDEMPOTENCY_KEY_REQUIRED", "Idempotency-Key header is required"))
+		return
+	}
+	var req wbFulfillRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.BadRequest(c, "invalid request: "+err.Error())
+		return
+	}
+	status, err := h.paymentService.WBFulfillDeferredOrder(c.Request.Context(), c.Param("out_trade_no"), req.UserID, req.DeviceBinding)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, status)
+}
