+func TestWBFulfillRedeemsToDeviceUserIdempotently(t *testing.T) {
+	f := newWBDeferredFixture(t, "wb_fulfill")
+	f.payAndHold(t)
+	ctx := context.Background()
+
+	status, err := f.svc.WBFulfillDeferredOrder(ctx, f.order.OutTradeNo, f.device.ID, "device-hmac-1")
+	require.NoError(t, err)
+	require.Equal(t, OrderStatusCompleted, status.Status)
+	require.Equal(t, f.device.ID, status.RedeemedToUserID)
+
+	require.Equal(t, []int64{f.device.ID}, f.userRepo.credits)
+	require.Equal(t, f.order.Amount, f.userRepo.balances[f.device.ID])
+	require.Zero(t, f.userRepo.balances[f.escrow.ID], "escrow user must never be credited")
+
+	// Repeat with the same user: idempotent, no double credit.
+	again, err := f.svc.WBFulfillDeferredOrder(ctx, f.order.OutTradeNo, f.device.ID, "device-hmac-1")
+	require.NoError(t, err)
+	require.Equal(t, OrderStatusCompleted, again.Status)
+	require.Equal(t, []int64{f.device.ID}, f.userRepo.credits)
+
+	// A different user must get a conflict.
+	_, err = f.svc.WBFulfillDeferredOrder(ctx, f.order.OutTradeNo, f.escrow.ID, "device-hmac-1")
+	require.Error(t, err)
+	require.True(t, infraerrors.IsConflict(err))
