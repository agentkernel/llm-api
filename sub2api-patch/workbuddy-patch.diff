+func (r *wbDeferredRedeemRepo) GetByID(_ context.Context, id int64) (*RedeemCode, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, code := range r.codesByCode {
+		if code.ID == id {
+			cloned := *code
+			return &cloned, nil
+		}
+	}
+	return nil, ErrRedeemCodeNotFound
+}
+
+func (r *wbDeferredRedeemRepo) GetByCode(_ context.Context, code string) (*RedeemCode, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	redeemCode, ok := r.codesByCode[code]
+	if !ok {
+		return nil, ErrRedeemCodeNotFound
+	}
+	cloned := *redeemCode
+	return &cloned, nil
