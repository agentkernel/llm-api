diff --git a/backend/internal/service/payment_wb_deferred.go b/backend/internal/service/payment_wb_deferred.go
new file mode 100644
index 0000000..b7bbc8a
--- /dev/null
+++ b/backend/internal/service/payment_wb_deferred.go
@@ -0,0 +1,376 @@
+package service
+
+// WorkBuddy patch: deferred balance fulfillment.
+//
+// Orders created through the WorkBuddy service API carry wb_deferred=true in
+// their provider snapshot. For those orders the webhook-driven fulfillment
+// stops right after the recharge redeem code has been created: the order is
+// parked in PAID_PENDING_REDEEM and no balance is credited to the order user
+// (an escrow account owned by the companion service). The companion service
+// later calls WBFulfillDeferredOrder with the real device user, which redeems
+// the held code to that user and completes the order.
+//
+// Everything WorkBuddy-specific lives in this file plus small, clearly marked
+// insertions in payment_fulfillment.go / payment_order.go / payment_service.go
+// so upstream rebases stay cheap.
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	"github.com/Wei-Shaw/sub2api/ent/paymentorder"
+	"github.com/Wei-Shaw/sub2api/internal/payment"
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+)
+
+const (
+	wbSnapshotDeferredKey = "wb_deferred"
+	wbSnapshotDeviceKey   = "wb_device"
+
+	wbAuditHeld      = "WB_HELD_PENDING_REDEEM"
+	wbAuditFulfilled = "WB_FULFILLED"
+	wbAuditOperator  = "wb-service"
+)
+
+func isWBDeferredOrder(o *dbent.PaymentOrder) bool {
+	if o == nil || len(o.ProviderSnapshot) == 0 {
+		return false
+	}
+	v, ok := o.ProviderSnapshot[wbSnapshotDeferredKey]
+	if !ok {
+		return false
+	}
+	switch typed := v.(type) {
+	case bool:
+		return typed
+	case string:
+		return strings.EqualFold(strings.TrimSpace(typed), "true")
+	default:
+		return false
+	}
+}
+
+func wbOrderDeviceBinding(o *dbent.PaymentOrder) string {
+	if o == nil || len(o.ProviderSnapshot) == 0 {
+		return ""
+	}
+	return psSnapshotStringValue(o.ProviderSnapshot[wbSnapshotDeviceKey])
+}
+
+// WBCreateDeferredOrderRequest is a service-to-service order creation request.
+type WBCreateDeferredOrderRequest struct {
+	UserID        int64
+	Amount        float64
+	PaymentType   string
+	DeviceBinding string
+	ClientIP      string
+	SrcHost       string
+}
+
+// WBCreateDeferredOrder creates a balance order whose fulfillment is deferred.
+// The order is attributed to req.UserID (the companion escrow user); that user
+// never receives the balance because fulfillment is intercepted.
+func (s *PaymentService) WBCreateDeferredOrder(ctx context.Context, req WBCreateDeferredOrderRequest) (*CreateOrderResponse, error) {
+	if req.UserID <= 0 {
+		return nil, infraerrors.BadRequest("INVALID_INPUT", "user_id is required")
+	}
+	resp, err := s.CreateOrder(ctx, CreateOrderRequest{
+		UserID:          req.UserID,
+		Amount:          req.Amount,
+		PaymentType:     req.PaymentType,
+		ClientIP:        req.ClientIP,
+		SrcHost:         req.SrcHost,
+		OrderType:       payment.OrderTypeBalance,
+		WBDeferred:      true,
+		WBDeviceBinding: req.DeviceBinding,
+	})
+	if err != nil {
+		return nil, err
+	}
+	// Belt and suspenders: make sure the deferred flag actually landed in the
+	// snapshot before the QR code is handed out (nobody can pay earlier, so
+	// fixing it here is race-free).
+	if resp.OrderID > 0 {
+		if err := s.wbEnsureDeferredFlag(ctx, resp.OrderID, req.DeviceBinding); err != nil {
+			return nil, err
+		}
+	}
+	return resp, nil
+}
+
+func (s *PaymentService) wbEnsureDeferredFlag(ctx context.Context, orderID int64, deviceBinding string) error {
+	o, err := s.entClient.PaymentOrder.Get(ctx, orderID)
+	if err != nil {
+		return fmt.Errorf("reload deferred order: %w", err)
+	}
+	if isWBDeferredOrder(o) {
+		return nil
+	}
+	snapshot := o.ProviderSnapshot
+	if snapshot == nil {
+		snapshot = map[string]any{}
+	}
+	snapshot[wbSnapshotDeferredKey] = true
+	if binding := strings.TrimSpace(deviceBinding); binding != "" {
+		snapshot[wbSnapshotDeviceKey] = binding
+	}
+	if _, err := s.entClient.PaymentOrder.UpdateOneID(o.ID).SetProviderSnapshot(snapshot).Save(ctx); err != nil {
+		return fmt.Errorf("persist deferred flag: %w", err)
+	}
+	return nil
+}
+
+// executeWBDeferredHold parks a paid deferred order in PAID_PENDING_REDEEM.
+// It ensures the recharge redeem code exists (idempotently) but does NOT
+// redeem it. Called from executeFulfillment for wb_deferred balance orders.
+func (s *PaymentService) executeWBDeferredHold(ctx context.Context, o *dbent.PaymentOrder) error {
+	switch {
+	case o == nil:
+		return infraerrors.BadRequest("INVALID_STATUS", "nil payment order")
+	case o.Status == OrderStatusPaidPendingRedeem || o.Status == OrderStatusCompleted:
+		return nil
+	case psIsRefundStatus(o.Status):
+		return infraerrors.BadRequest("INVALID_STATUS", "refund-related order cannot hold")
+	case o.Status != OrderStatusPaid && o.Status != OrderStatusFailed && o.Status != OrderStatusRecharging:
+		return infraerrors.BadRequest("INVALID_STATUS", "order cannot hold in status "+o.Status)
+	}
+	lease, err := s.acquirePaymentFulfillmentLease(ctx, o)
+	if err != nil {
+		return err
+	}
+	if lease == nil {
+		return nil
+	}
+
+	existing, lookupErr := s.redeemService.GetByCode(ctx, o.RechargeCode)
+	switch resolveRedeemAction(existing, lookupErr) {
+	case redeemActionSkipCompleted:
+		// The code was already redeemed (a concurrent fulfill won) — finish.
+		return s.markCompleted(ctx, o, lease, "RECHARGE_SUCCESS")
+	case redeemActionCreate:
+		rc := &RedeemCode{Code: o.RechargeCode, Type: RedeemTypeBalance, Value: o.Amount, Status: StatusUnused}
+		if err := s.redeemService.CreateCode(ctx, rc); err != nil {
+			s.markFailed(ctx, o.ID, lease, err)
+			return fmt.Errorf("create held redeem code: %w", err)
+		}
+	case redeemActionRedeem:
+		// Code exists and is unused — nothing to create.
+	}
+
+	updated, err := s.entClient.PaymentOrder.Update().Where(
+		paymentorder.IDEQ(o.ID),
+		paymentorder.StatusEQ(OrderStatusRecharging),
+		paymentorder.UpdatedAtEQ(lease.version),
+	).SetStatus(OrderStatusPaidPendingRedeem).Save(ctx)
+	if err != nil {
+		return fmt.Errorf("park order pending redeem: %w", err)
+	}
+	if updated == 0 {
+		current, getErr := s.entClient.PaymentOrder.Get(ctx, o.ID)
+		if getErr == nil && (current.Status == OrderStatusPaidPendingRedeem || current.Status == OrderStatusCompleted) {
+			return nil
+		}
+		return infraerrors.Conflict("CONFLICT", "fulfillment lease was lost before hold")
+	}
+	if !s.hasAuditLog(ctx, o.ID, wbAuditHeld) {
+		s.writeAuditLog(ctx, o.ID, wbAuditHeld, wbAuditOperator, map[string]any{
+			"rechargeCode":  o.RechargeCode,
+			"amount":        o.Amount,
+			"deviceBinding": wbOrderDeviceBinding(o),
+		})
+	}
+	return nil
+}
+
+// WBOrderStatus is the minimal service-to-service view of a deferred order.
+type WBOrderStatus struct {
+	OrderID          int64      `json:"order_id"`
+	OutTradeNo       string     `json:"out_trade_no"`
+	Status           string     `json:"status"`
+	Amount           float64    `json:"amount"`
+	PayAmount        float64    `json:"pay_amount"`
+	DeviceBinding    string     `json:"device_binding,omitempty"`
+	RedeemedToUserID int64      `json:"redeemed_to_user_id,omitempty"`
+	ExpiresAt        time.Time  `json:"expires_at"`
+	PaidAt           *time.Time `json:"paid_at,omitempty"`
+	CompletedAt      *time.Time `json:"completed_at,omitempty"`
+}
+
+// WBGetDeferredOrder returns the state of a deferred order by out_trade_no.
+func (s *PaymentService) WBGetDeferredOrder(ctx context.Context, outTradeNo string) (*WBOrderStatus, error) {
+	o, err := s.wbLoadDeferredOrder(ctx, outTradeNo)
+	if err != nil {
+		return nil, err
+	}
+	return s.wbOrderStatus(ctx, o), nil
+}
+
+func (s *PaymentService) wbLoadDeferredOrder(ctx context.Context, outTradeNo string) (*dbent.PaymentOrder, error) {
+	outTradeNo = strings.TrimSpace(outTradeNo)
+	if outTradeNo == "" {
+		return nil, infraerrors.BadRequest("INVALID_INPUT", "out_trade_no is required")
+	}
+	o, err := s.entClient.PaymentOrder.Query().Where(paymentorder.OutTradeNo(outTradeNo)).Only(ctx)
+	if err != nil {
+		if dbent.IsNotFound(err) {
+			return nil, infraerrors.NotFound("NOT_FOUND", "order not found")
+		}
+		return nil, fmt.Errorf("lookup order: %w", err)
+	}
+	if !isWBDeferredOrder(o) {
+		return nil, infraerrors.BadRequest("NOT_DEFERRED", "order is not a deferred order")
+	}
+	return o, nil
+}
+
+func (s *PaymentService) wbOrderStatus(ctx context.Context, o *dbent.PaymentOrder) *WBOrderStatus {
+	status := &WBOrderStatus{
+		OrderID:       o.ID,
+		OutTradeNo:    o.OutTradeNo,
+		Status:        o.Status,
+		Amount:        o.Amount,
+		PayAmount:     o.PayAmount,
+		DeviceBinding: wbOrderDeviceBinding(o),
+		ExpiresAt:     o.ExpiresAt,
+		PaidAt:        o.PaidAt,
+		CompletedAt:   o.CompletedAt,
+	}
+	if o.Status == OrderStatusCompleted {
+		if rc, err := s.redeemService.GetByCode(ctx, o.RechargeCode); err == nil && rc != nil && rc.UsedBy != nil {
+			status.RedeemedToUserID = *rc.UsedBy
+		}
+	}
+	return status
+}
+
+// WBFulfillDeferredOrder redeems a parked order's held code to userID and
+// completes the order. Idempotent: repeating the call for the same user
+// returns the completed state; a different user gets 409.
+func (s *PaymentService) WBFulfillDeferredOrder(ctx context.Context, outTradeNo string, userID int64, deviceBinding string) (*WBOrderStatus, error) {
+	if userID <= 0 {
+		return nil, infraerrors.BadRequest("INVALID_INPUT", "user_id is required")
+	}
+	o, err := s.wbLoadDeferredOrder(ctx, outTradeNo)
+	if err != nil {
+		return nil, err
+	}
+	if expected := wbOrderDeviceBinding(o); expected != "" && !strings.EqualFold(expected, strings.TrimSpace(deviceBinding)) {
+		return nil, infraerrors.Conflict("DEVICE_MISMATCH", "order is bound to another device")
+	}
+
+	switch {
+	case o.Status == OrderStatusCompleted:
+		return s.wbCompletedResult(ctx, o, userID)
+	case psIsRefundStatus(o.Status):
+		return nil, infraerrors.BadRequest("INVALID_STATUS", "refund-related order cannot fulfill")
+	case o.Status == OrderStatusPending || o.Status == OrderStatusExpired || o.Status == OrderStatusCancelled:
+		return nil, infraerrors.BadRequest("NOT_PAID", "order is not paid yet")
+	case o.Status == OrderStatusPaid || o.Status == OrderStatusRecharging:
+		// Webhook processing in flight; the caller should retry shortly.
+		return nil, infraerrors.Conflict("PROCESSING", "order is being processed, retry later")
+	case o.Status != OrderStatusPaidPendingRedeem && o.Status != OrderStatusFailed:
+		return nil, infraerrors.BadRequest("INVALID_STATUS", "order cannot fulfill in status "+o.Status)
+	}
+
+	lease, err := s.acquireWBFulfillLease(ctx, o)
+	if err != nil {
+		return nil, err
+	}
+	if lease == nil {
+		return s.wbCompletedResult(ctx, o, userID)
+	}
+
+	// Guard against a held code that was somehow already consumed.
+	if rc, lookupErr := s.redeemService.GetByCode(ctx, o.RechargeCode); lookupErr == nil && rc != nil && rc.IsUsed() {
+		if rc.UsedBy == nil || *rc.UsedBy != userID {
+			s.markFailed(ctx, o.ID, lease, fmt.Errorf("held code already redeemed by another user"))
+			return nil, infraerrors.Conflict("ALREADY_REDEEMED", "order was already redeemed by another user")
+		}
+		if err := s.markCompleted(ctx, o, lease, "RECHARGE_SUCCESS"); err != nil {
+			return nil, err
+		}
+		return s.wbCompletedResult(ctx, o, userID)
+	}
+
+	if _, err := s.redeemService.Redeem(ContextSkipRedeemAffiliate(ctx), userID, o.RechargeCode); err != nil {
+		s.markFailed(ctx, o.ID, lease, err)
+		return nil, err
+	}
+	if !s.hasAuditLog(ctx, o.ID, wbAuditFulfilled) {
+		s.writeAuditLog(ctx, o.ID, wbAuditFulfilled, wbAuditOperator, map[string]any{
+			"redeemedTo":    userID,
+			"deviceBinding": strings.TrimSpace(deviceBinding),
+			"rechargeCode":  o.RechargeCode,
+			"amount":        o.Amount,
+		})
+	}
+	if err := s.markCompleted(ctx, o, lease, "RECHARGE_SUCCESS"); err != nil {
+		return nil, err
+	}
+	return s.wbCompletedResult(ctx, o, userID)
+}
+
+// wbCompletedResult returns the completed order state when the historical
+// redeem target matches userID, and a conflict otherwise.
+func (s *PaymentService) wbCompletedResult(ctx context.Context, o *dbent.PaymentOrder, userID int64) (*WBOrderStatus, error) {
+	current, err := s.entClient.PaymentOrder.Get(ctx, o.ID)
+	if err != nil {
+		return nil, fmt.Errorf("reload order: %w", err)
+	}
+	rc, err := s.redeemService.GetByCode(ctx, current.RechargeCode)
+	if err != nil || rc == nil || !rc.IsUsed() || rc.UsedBy == nil {
+		return nil, infraerrors.Conflict("CONFLICT", "order completion state is inconsistent, retry later")
+	}
+	if *rc.UsedBy != userID {
+		return nil, infraerrors.Conflict("ALREADY_REDEEMED", "order was already redeemed by another user")
+	}
+	return s.wbOrderStatus(ctx, current), nil
+}
+
+// acquireWBFulfillLease is the deferred-order variant of
+// acquirePaymentFulfillmentLease: it claims PAID_PENDING_REDEEM / FAILED
+// orders (or stale RECHARGING ones) by CAS-ing them into RECHARGING.
+func (s *PaymentService) acquireWBFulfillLease(ctx context.Context, o *dbent.PaymentOrder) (*paymentFulfillmentLease, error) {
+	now := time.Now().UTC().Truncate(time.Microsecond)
+	staleBefore := now.Add(-paymentFulfillmentLeaseDuration)
+	updated, err := s.entClient.PaymentOrder.Update().
+		Where(
+			paymentorder.IDEQ(o.ID),
+			paymentorder.Or(
+				paymentorder.StatusIn(OrderStatusPaidPendingRedeem, OrderStatusFailed),
+				paymentorder.And(
+					paymentorder.StatusEQ(OrderStatusRecharging),
+					paymentorder.UpdatedAtLTE(staleBefore),
+				),
+			),
+		).
+		SetStatus(OrderStatusRecharging).
+		SetUpdatedAt(now).
+		ClearFailedAt().
+		ClearFailedReason().
+		Save(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("acquire wb fulfill lease: %w", err)
+	}
+	if updated == 0 {
+		current, getErr := s.entClient.PaymentOrder.Get(ctx, o.ID)
+		if getErr != nil {
+			return nil, fmt.Errorf("reload wb fulfill lease: %w", getErr)
+		}
+		if current.Status == OrderStatusCompleted {
+			return nil, nil
+		}
+		return nil, infraerrors.Conflict("CONFLICT", "order is being processed, retry later")
+	}
+	claimed, err := s.entClient.PaymentOrder.Get(ctx, o.ID)
+	if err != nil {
+		return nil, fmt.Errorf("reload acquired wb fulfill lease: %w", err)
+	}
+	if claimed.Status != OrderStatusRecharging {
+		return nil, infraerrors.Conflict("CONFLICT", "wb fulfill lease was lost")
+	}
+	return &paymentFulfillmentLease{version: claimed.UpdatedAt}, nil
+}
