+type wbDeferredRedeemRepo struct {
+	mu          sync.Mutex
+	nextID      int64
+	codesByCode map[string]*RedeemCode
+}
+
+func newWBDeferredRedeemRepo() *wbDeferredRedeemRepo {
+	return &wbDeferredRedeemRepo{codesByCode: map[string]*RedeemCode{}}
+}
+
+func (r *wbDeferredRedeemRepo) Create(_ context.Context, code *RedeemCode) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.nextID++
+	code.ID = r.nextID
+	cloned := *code
+	r.codesByCode[code.Code] = &cloned
+	return nil
+}
+
+func (r *wbDeferredRedeemRepo) CreateBatch(context.Context, []RedeemCode) error {
